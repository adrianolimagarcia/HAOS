{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRun",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "assignment_id", "status", "started_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "assignment_id": { "type": "string" },
    "status": { "type": "string", "enum": ["preparing", "running", "completed", "failed", "cancelled", "timed_out"] },
    "worker_id": { "type": "string" },
    "lane": { "type": "string" },
    "started_at": { "type": "number" },
    "heartbeat_at": { "type": ["number", "null"] },
    "ended_at": { "type": ["number", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
