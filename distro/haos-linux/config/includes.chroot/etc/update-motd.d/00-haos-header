#!/usr/bin/env bash
# ==============================================================================
# HAOS Linux - Dynamic MOTD Banner
# Mostra status do sistema, BBR, ZRAM, IP e serviços HAOS no login
# ==============================================================================

# Cores ANSI
CYAN="\033[1;36m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
PURPLE="\033[1;35m"
BOLD="\033[1m"
RESET="\033[0m"

clear
echo -e "${CYAN}"
cat << 'EOF'
  _    _          ____   _____   _      _                  
 | |  | |   /\   / __ \ / ____| | |    (_)                 
 | |__| |  /  \ | |  | | (___   | |     _ _ __  _   ___  __
 |  __  | / /\ \| |  | |\___ \  | |    | | '_ \| | | \ \/ /
 | |  | |/ ____ \ |__| |____) | | |____| | | | | |_| |>  < 
 |_|  |_/_/    \_\____/|_____/  |______|_|_| |_|\__,_/_/\_\
EOF
echo -e "${RESET}"
echo -e "${BOLD}HAOS Linux 1.0 (Debian 13 Trixie) - Autonomous AI Operating System${RESET}"
echo -e "${BLUE}Kernel:${RESET} $(uname -r) (BBRv3 + FQ + Btrfs zstd)"
echo -e "────────────────────────────────────────────────────────────────────────"

# Status do Sistema
UPTIME=$(uptime -p 2>/dev/null || uptime)
LOAD=$(cut -d " " -f1-3 /proc/loadavg)
MEM_TOTAL=$(free -h | awk '/Mem:/ {print $2}')
MEM_USED=$(free -h | awk '/Mem:/ {print $3}')
ZRAM_STATUS=$(swapon --show 2>/dev/null | grep zram || echo "zram inativo")
IP_LOCAL=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I | awk '{print $1}')

echo -e "${GREEN}● Status Geral:${RESET}"
echo -e "  • Uptime:      ${UPTIME}"
echo -e "  • Carga CPU:   ${LOAD}"
echo -e "  • Memória RAM: ${MEM_USED} / ${MEM_TOTAL}"
echo -e "  • IP do Nó:    ${IP_LOCAL:-127.0.0.1}"

echo ""
echo -e "${PURPLE}● Daemons do HAOS:${RESET}"

# Checar serviços
check_svc() {
    local svc="$1"
    local name="$2"
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        echo -e "  • ${name}: ${GREEN}● ATIVO (ONLINE)${RESET}"
    else
        echo -e "  • ${name}: ${YELLOW}○ DESLIGADO / INATIVO${RESET}"
    fi
}

check_svc haos-gateway "HAOS Gateway (AI Core)"
check_svc haos-mesh "HAOS Mesh Node (P2P)"
check_svc haos-edge "HAOS Edge Daemon (Rust)"
check_svc haos-antigravity "Antigravity Proxy (Port 8790)"
check_svc haos-dns "HAOS Rust DNS Cache (127.0.0.1)"

echo ""
echo -e "${CYAN}● Runtimes & Providers:${RESET}"
echo -e "  • Python 3.13: /opt/haos/venv/bin/python"
echo -e "  • Node.js 26:  $(node -v 2>/dev/null || echo 'instalado')"
echo -e "  • Providers:   a6api (cloud) | antigravity (local wrapper)"
echo -e "────────────────────────────────────────────────────────────────────────"
echo -e "Comandos rápidos: ${BOLD}haos-setup${RESET} (instalar/atualizar via Git) | ${BOLD}haos chat${RESET} | ${BOLD}haos status${RESET} | ${BOLD}haos logs${RESET}"
echo ""
