# ==============================================================================
# HAOS Model Providers Configuration Template
# (As chaves de API NÃO vêm pré-configuradas por segurança)
# ==============================================================================

# Provider 1: A6API (Nuvem Oficial)
A6API_BASE_URL="https://api.a6api.com/v1"
# A6API_API_KEY=""

# Provider 2: Antigravity (Wrapper Local Gemini OAuth)
ANTIGRAVITY_BASE_URL="http://127.0.0.1:8790/v1"
ANTIGRAVITY_PROXY_PORT=8790
ANTIGRAVITY_TOKEN_FILE="/home/haos/.gemini/antigravity-cli/antigravity-oauth-token"
# ANTIGRAVITY_API_KEY="" # Opcional/Dummy para compatibilidade com clientes OpenAI
