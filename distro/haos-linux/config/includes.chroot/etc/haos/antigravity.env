# ==============================================================================
# Configuração do wrapper-antigravity (lida pela unidade via
# EnvironmentFile=-/etc/haos/antigravity.env).
#
# Divisão de responsabilidade: a unidade haos-antigravity.service fixa o que é
# *layout do serviço* (HOST, PORT, TOKEN_FILE, OPENCODE_ACCOUNTS); este arquivo
# cuida do que é *estado* do processo. Um lugar por variável — variável repetida
# aqui vence a da unidade, porque EnvironmentFile é aplicado depois.
#
# Por que estes caminhos existem: sem eles o wrapper usa
# DATA_DIR = diretório do próprio server.mjs e grava cache/spend/providers.json
# dentro de /opt/haos/wrapper-antigravity/. Funciona (o hook 05 torna /opt/haos
# do usuário haos), mas estado de serviço em diretório de código se perde quando
# o código é substituído — e saveExternalProviders() grava providers.json SEM
# criar o diretório, então um caminho inexistente ali vira exceção.
# O diretório /var/lib/haos/antigravity é criado (dono haos:haos) pelo hook
# 05-create-haos-user.chroot.
# ==============================================================================

ANTIGRAVITY_CACHE_FILE=/var/lib/haos/antigravity/response-cache.json
ANTIGRAVITY_SPEND_FILE=/var/lib/haos/antigravity/spend.json
ANTIGRAVITY_PROVIDERS_FILE=/var/lib/haos/antigravity/providers.json

# Opcionais (o padrão do upstream já é sensato; descomente para mudar):
# ANTIGRAVITY_LOG_FILE=/var/lib/haos/antigravity/proxy.log  # liga log em arquivo
# ANTIGRAVITY_DEBUG=1                                       # body sanitizado no log
# ANTIGRAVITY_THINKING_LEVEL=low
# ANTIGRAVITY_MAX_CONCURRENT=30
# ANTIGRAVITY_TIMEOUT_MS=120000
# ANTIGRAVITY_PROJECT=aicode-consumers

# NÃO configure ANTIGRAVITY_PROXY_HOST=0.0.0.0 aqui: o proxy fala OAuth da sua
# conta e a unidade já o prende em 127.0.0.1 (o padrão do upstream é 0.0.0.0,
# que exporia o proxy para a rede local).
