[Unit]
Description=HAOS Edge Rust Web & PTY Control Plane
After=network.target haos-storage-init.service
Wants=haos-storage-init.service

[Service]
Type=simple
User=haos
Group=haos
WorkingDirectory=/opt/haos
Environment="HAOS_HOME=/home/haos/.haos"
Environment="HAOS_DATA_DIR=/var/lib/haos/edge"
Environment="PATH=/opt/haos/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/local/bin/haos-edge server --port 8788 --host 127.0.0.1 --static-dir /opt/haos/hermes/platform/webui/static
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
