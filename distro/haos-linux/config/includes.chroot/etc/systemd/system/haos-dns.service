[Unit]
Description=HAOS High-Performance Rust DNS Caching Resolver
After=network.target
Before=network-online.target haos-gateway.service
Wants=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/haos-dns
Restart=always
RestartSec=2
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
