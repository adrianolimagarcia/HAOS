[Unit]
Description=HAOS Gateway & AI Agent Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haos
Group=haos
WorkingDirectory=/opt/haos
Environment="HAOS_HOME=/home/haos/.haos"
Environment="PYTHONUNBUFFERED=1"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/haos/.playwright"
Environment="PATH=/opt/haos/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LD_PRELOAD=/usr/local/lib/libsqlite3.so.0"
ExecStart=/opt/haos/venv/bin/python /opt/haos/gateway/run.py
Restart=always
RestartSec=3
LimitNOFILE=65535
LimitNPROC=32768
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
