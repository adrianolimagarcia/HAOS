#!/usr/bin/env bash
set -euo pipefail

bin="${HERMES_EXEC_BIN:-/usr/local/bin/hermes-exec}"
command -v "$bin" >/dev/null 2>&1 || { echo "hermes-exec unavailable" >&2; exit 1; }
root="$(mktemp -d /run/hermes-exec-health.XXXXXX)"
trap 'rm -rf "$root"' EXIT
(timeout 5s "$bin" --version >/dev/null) || { echo "hermes-exec version probe failed" >&2; exit 1; }
response="$(timeout 5s bash -c 'printf "%s\n" "$1" | HERMES_EXEC_ROOT="$2" "$3"' _ '{"id":1,"method":"exec","params":{"argv":["true"],"cwd":".","timeout_ms":1000,"max_output_bytes":1024}}' "$root" "$bin")"
[ "${#response}" -le 65536 ] || { echo "hermes-exec health response too large" >&2; exit 1; }
printf '%s' "$response" | python3 -c 'import json,sys; r=json.load(sys.stdin); assert r.get("result",{}).get("returncode") == 0 and not r.get("error")'
