#!/usr/bin/env bash
# ==============================================================================
# Live Hook: Credencial read-only de atualização embarcada na imagem
# ------------------------------------------------------------------------------
# A deploy key read-only (github.com/adrianolimagarcia/HAOS) é injetada em
# /etc/haos/keys/update_ed25519 no momento do BUILD (build-iso.sh) — ela nunca
# vive no git. Ela é OPCIONAL: com o repositório público, o clone/fetch via
# HTTPS funciona sem nenhuma credencial; a chave só é necessária para repo
# privado.
#
# O checkout em /opt/haos NÃO existe dentro da imagem (o código chega no
# primeiro boot, via haos-setup/haos-install), então o wiring do origin
# (fetch via chave / push via HTTPS) acontece DEPOIS do clone, no setup — este
# hook apenas prepara o terreno para que esse clone e os updates seguintes
# (executados como usuário haos) funcionem:
#   1. hardening 0600 root:root da chave de bootstrap em /etc/haos/keys;
#   2. cópia da chave para o store do nó /home/haos/.haos/keys com dono
#      haos:haos 0600 — quem roda `haos update` é o usuário haos, não root;
#   3. host key do github.com em /etc/ssh/ssh_known_hosts legível (0644) por
#      qualquer usuário (SSH não-interativo recusa primeiro contato).
# Idempotente: roda em qualquer ordem relativa aos outros hooks.
# ==============================================================================
set -euo pipefail

BOOT_KEY="/etc/haos/keys/update_ed25519"
NODE_KEY_DIR="/home/haos/.haos/keys"
NODE_KEY="${NODE_KEY_DIR}/update_ed25519"
KNOWN_HOSTS="/etc/ssh/ssh_known_hosts"

echo "[HAOS Hook] Provisionando credencial read-only de update..."

# 1. Hardening da chave de bootstrap (root)
if [ -f "${BOOT_KEY}" ]; then
    chmod 600 "${BOOT_KEY}"
    chown root:root "${BOOT_KEY}" 2>/dev/null || true
    echo "[HAOS Hook] Chave de bootstrap pronta em ${BOOT_KEY}"
else
    echo "[HAOS Hook] ⚠ ${BOOT_KEY} ausente — com repo público o HTTPS funciona sem chave."
fi

# 2. Cópia para o store do nó (dono haos) — `haos update` roda como o usuário haos.
if [ -f "${BOOT_KEY}" ] && id haos >/dev/null 2>&1; then
    mkdir -p "${NODE_KEY_DIR}"
    # O home do haos pode acabar root-owned no chroot; devolve o caminho do
    # store ao dono certo para o nó funcionar antes mesmo do Passo 4 do setup.
    chown -R haos:haos "/home/haos/.haos" 2>/dev/null || true
    install -o haos -g haos -m 600 "${BOOT_KEY}" "${NODE_KEY}" 2>/dev/null || true
    if [ -f "${NODE_KEY}" ]; then
        echo "[HAOS Hook] Chave do nó pronta em ${NODE_KEY} (dono haos:haos, 0600)"
    fi
fi

# 3. Host key do github.com em known_hosts, world-readable (fetch roda como haos).
# A fingerprint já viaja embarcada via config/includes.chroot/etc/ssh/ssh_known_hosts;
# o ssh-keyscan abaixo é apenas fallback se ssh-keygen/ssh-keyscan existirem no chroot.
if command -v ssh-keygen >/dev/null 2>&1 && command -v ssh-keyscan >/dev/null 2>&1; then
    if [ ! -f "${KNOWN_HOSTS}" ] || ! ssh-keygen -F github.com -f "${KNOWN_HOSTS}" >/dev/null 2>&1; then
        mkdir -p /etc/ssh
        ssh-keyscan -t ed25519 github.com >> "${KNOWN_HOSTS}" 2>/dev/null || \
            echo "[HAOS Hook] ⚠ Não foi possível obter o host key do github.com agora (fallback)."
    fi
fi
if [ -f "${KNOWN_HOSTS}" ]; then
    chmod 644 "${KNOWN_HOSTS}"
    chown root:root "${KNOWN_HOSTS}" 2>/dev/null || true
    echo "[HAOS Hook] Host key github.com registrado em ${KNOWN_HOSTS}"
else
    echo "[HAOS Hook] ⚠ ${KNOWN_HOSTS} ausente — o SSH não-interativo recusará o primeiro contato."
fi

echo "[HAOS Hook] Credencial read-only provisionada (origin será configurado no pós-clone pelo haos-setup)."
