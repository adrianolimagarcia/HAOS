#!/usr/bin/env bash
# ==============================================================================
# Live Hook: Credencial read-only de atualização embarcada na imagem
# ------------------------------------------------------------------------------
# A deploy key read-only (github.com/adrianolimagarcia/HAOS) é injetada em
# /etc/haos/keys/update_ed25519 no momento do BUILD (build-iso.sh) — ela nunca
# vive no git. Este hook:
#   1. garante permissões 0600 da chave;
#   2. garante o host key do github.com em /etc/ssh/ssh_known_hosts;
#   3. se o checkout HAOS já existir em /opt/haos, aponta o fetch do origin
#      para a chave read-only (push continua HTTPS — credencial de admin).
# Idempotente: roda em qualquer ordem relativa aos outros hooks.
# ==============================================================================
set -euo pipefail

KEY_FILE="/etc/haos/keys/update_ed25519"
HAOS_CHECKOUT="/opt/haos"

echo "[HAOS Hook] Provisionando credencial read-only de update..."

# 1. Hardening da chave embarcada
if [ -f "${KEY_FILE}" ]; then
    chmod 600 "${KEY_FILE}"
    chown root:root "${KEY_FILE}" 2>/dev/null || true
    echo "[HAOS Hook] Chave read-only pronta em ${KEY_FILE}"
else
    echo "[HAOS Hook] ⚠ ${KEY_FILE} ausente — 'haos update' dependerá de outra credencial."
fi

# 2. Host key do github.com (SSH não-interativo recusa primeiro contato)
if [ -f /etc/ssh/ssh_known_hosts ] && ssh-keygen -F github.com -f /etc/ssh/ssh_known_hosts >/dev/null 2>&1; then
    echo "[HAOS Hook] Host key github.com já presente."
else
    echo "[HAOS Hook] ⚠ Host key github.com ausente de /etc/ssh/ssh_known_hosts."
fi

# 3. Checkout embarcado: fetch read-only / push HTTPS (se /opt/haos for um repo git)
if [ -d "${HAOS_CHECKOUT}/.git" ]; then
    cd "${HAOS_CHECKOUT}"
    git remote set-url origin "git@github.com:adrianolimagarcia/HAOS.git" 2>/dev/null || true
    git remote set-url --push origin "https://github.com/adrianolimagarcia/HAOS.git" 2>/dev/null || true
    if [ -f "${KEY_FILE}" ]; then
        git config core.sshCommand "ssh -i ${KEY_FILE} -o IdentitiesOnly=yes"
        echo "[HAOS Hook] origin de ${HAOS_CHECKOUT}: fetch via chave read-only; push via HTTPS."
    fi
else
    echo "[HAOS Hook] ${HAOS_CHECKOUT} ainda não é um repo git — instalador fará o clone na primeira execução."
fi

echo "[HAOS Hook] Credencial read-only provisionada."
