#!/usr/bin/env bash
# ==============================================================================
# Live Hook: Criação do usuário 'haos' e grupos de sistema
# ==============================================================================
set -euo pipefail

echo "[HAOS Hook] Criando usuário e grupos para o ambiente HAOS..."

# Criar usuário 'haos' se não existir
if ! id -u haos >/dev/null 2>&1; then
    # uid fixo em 1000: haos-gateway.service aponta XDG_RUNTIME_DIR para /run/user/1000
    # (caminho literal — especificador %U não é resolvido em unit de sistema, verificado na
    # VM) para que o handoff restart-safe (systemd-run --user --scope) alcance o user
    # manager. Sem -u, o uid seria o primeiro livre e o caminho do unit apontaria para o
    # runtime dir errado. Fallback: se 1000 estiver ocupado, cria com o próximo livre — o
    # handoff então degrada por cron.restart_safe_scope: prefer em vez de derrubar o install.
    useradd -u 1000 -m -s /bin/bash -U haos 2>/dev/null \
        || useradd -m -s /bin/bash -U haos
    # Senha padrão inicial 'haos' (pode ser alterada no primeiro login)
    echo "haos:haos" | chpasswd
fi

# Adicionar o usuário aos grupos de hardware e privilégios
for grp in sudo audio video plugdev kvm docker netdev; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -aG "$grp" haos 2>/dev/null || true
    fi
done

# Permissões da home e de /opt/haos
chown -R haos:haos /home/haos 2>/dev/null || true
mkdir -p /opt/haos /var/lib/haos
# Estado do wrapper-antigravity (cache/spend/providers.json), apontado por
# /etc/haos/antigravity.env. Precisa existir já na imagem: o wrapper grava
# providers.json sem criar o diretório (saveExternalProviders), e um caminho
# inexistente ali vira exceção em runtime.
mkdir -p /var/lib/haos/antigravity
chown -R haos:haos /opt/haos /var/lib/haos 2>/dev/null || true

# Diretório de trabalho do agente (terminal.cwd, gravado por haos-setup). Precisa existir já na
# imagem: sem ele a resolução de cwd cai na árvore de instalação (/opt/haos) e o agente passa a
# operar dentro do próprio código que o mantém.
mkdir -p /home/haos/workspace
chown haos:haos /home/haos/workspace 2>/dev/null || true

echo "[HAOS Hook] Usuário 'haos' configurado com sucesso!"
