# ============================================================
# HAOS Linux distro — never commit generated or sensitive files
# ============================================================

# Build artifacts (large / regenerable)
.build/
binary/
cache/
# Anchored: only the live-build scratch dir at the distro root. A bare `local/`
# would also swallow config/includes.chroot/usr/local/bin/* (the HAOS wrapper
# and setup script) — anything under an unanchored "local" directory name.
/local/
chroot/
*.iso
*.iso.sha256
*.packages
*.files
chroot.installed_tmp_pkgs

# Sensitive: read-only deploy key injected AT BUILD TIME by build-iso.sh
# (never commit the private key — history survives revocation)
config/includes.chroot/etc/haos/keys/

# Installer copy injected at build time (source of truth is repo scripts/install_haos.sh)
config/includes.chroot/usr/local/sbin/haos-install

# Runtimes pré-baixados (Node/uv/SQLite) injetados no build pelos hooks 10/15/20/30
config/includes.chroot/usr/local/src/haos-factory/

# Baixados por scripts/fetch-dependencies.sh (cache de build)
assets/

# Artefatos de build antigos que sobram no tree
chroot.packages.*
chroot.files
chroot.installed_tmp_pkgs
haos-linux-*.packages
haos-linux-*.files
# Sobras de cada `lb build` (visto no git status depois do build de 10/09):
# o lock do live-build, o carimbo de mtimes do estágio binary e o índice de
# conteúdo da imagem. Regeneráveis — nenhum deles é fonte.
.lock
binary.modified_timestamps
*.contents
