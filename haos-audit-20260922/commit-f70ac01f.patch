diff --git a/tests/test_haos_runtime_profile_compat.py b/tests/test_haos_runtime_profile_compat.py
new file mode 100644
index 00000000..8f452803
--- /dev/null
+++ b/tests/test_haos_runtime_profile_compat.py
@@ -0,0 +1,84 @@
+"""Behavior regressions for HAOS runtime/profile compatibility."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+import types
+
+
+def test_oauth_default_auth_path_follows_active_profile_but_explicit_path_wins(
+    monkeypatch, tmp_path
+):
+    import api.oauth as oauth
+
+    profile_home = tmp_path / "profile-a"
+    profile_home.mkdir()
+    monkeypatch.setattr(oauth, "_get_active_hermes_home", lambda: profile_home)
+    monkeypatch.setattr(oauth, "AUTH_JSON_PATH", oauth._INITIAL_AUTH_JSON_PATH)
+
+    oauth._write_auth_json({"profile": "active"})
+    assert (profile_home / "auth.json").exists()
+    assert oauth._read_auth_json() == {"profile": "active"}
+
+    explicit_path = tmp_path / "explicit" / "auth.json"
+    oauth._write_auth_json({"profile": "explicit"}, auth_path=explicit_path)
+    assert oauth._read_auth_json(explicit_path) == {"profile": "explicit"}
+    assert "explicit" not in (profile_home / "auth.json").read_text(encoding="utf-8")
+
+
+def test_provider_model_lookup_uses_configured_agent_dir(monkeypatch, tmp_path):
+    import api.config as api_config
+    from api import routes
+
+    agent_dir = tmp_path / "haos-agent"
+    agent_dir.mkdir()
+    monkeypatch.setattr(api_config, "_AGENT_DIR", agent_dir)
+
+    calls: list[str] = []
+    models_module = types.ModuleType("hermes_cli.models")
+    models_module.provider_model_ids = lambda provider: calls.append(provider) or ["haos-model"]
+    package_module = types.ModuleType("hermes_cli")
+    package_module.__path__ = []
+    monkeypatch.setitem(sys.modules, "hermes_cli", package_module)
+    monkeypatch.setitem(sys.modules, "hermes_cli.models", models_module)
+
+    assert routes._provider_model_ids_from_agent("openai") == ["haos-model"]
+    assert calls == ["openai"]
+    assert str(agent_dir.resolve()) in sys.path
+
+
+def test_bootstrap_prefers_configured_python_for_agent_discovery(monkeypatch, tmp_path):
+    import bootstrap
+
+    configured_python = str(tmp_path / "haos-python")
+    configured_agent = tmp_path / "configured-agent"
+    monkeypatch.setenv("HERMES_WEBUI_PYTHON", configured_python)
+    monkeypatch.setattr(bootstrap, "_agent_dir_from_python", lambda value: configured_agent if value == configured_python else None)
+    monkeypatch.setattr(bootstrap, "_agent_dir_from_hermes_cli", lambda: (_ for _ in ()).throw(AssertionError("CLI fallback used")))
+    monkeypatch.setattr(bootstrap, "REPO_ROOT", tmp_path)
+    monkeypatch.setattr(bootstrap, "shutil", types.SimpleNamespace(which=lambda _: None))
+
+    assert bootstrap.discover_agent_dir() == configured_agent
+
+
+def test_startup_auto_install_uses_configured_runtime_python(monkeypatch, tmp_path):
+    import api.startup as startup
+
+    agent_dir = tmp_path / "agent"
+    agent_dir.mkdir()
+    (agent_dir / "requirements.txt").write_text("example-package\n", encoding="utf-8")
+    runtime_python = str(tmp_path / "haos-python")
+    monkeypatch.setenv("HERMES_WEBUI_AUTO_INSTALL", "1")
+    monkeypatch.setenv("HERMES_WEBUI_PYTHON", runtime_python)
+    monkeypatch.setattr(startup, "_agent_dir", lambda: agent_dir)
+    monkeypatch.setattr(startup, "_trusted_agent_dir", lambda _: True)
+    seen: list[list[str]] = []
+
+    def fake_run(argv, **kwargs):
+        seen.append(argv)
+        return subprocess.CompletedProcess(argv, 0, stdout="", stderr="")
+
+    monkeypatch.setattr(startup.subprocess, "run", fake_run)
+    assert startup.auto_install_agent_deps() is True
+    assert seen == [[runtime_python, "-m", "pip", "install", "--quiet", "-r", str(agent_dir / "requirements.txt")]]
