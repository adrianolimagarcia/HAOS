+@pytest.mark.parametrize('operation', [
+    lambda: updates.apply_update('agent'),
+    lambda: updates.apply_force_update('agent'),
+    lambda: updates.apply_clear_lock('agent'),
+])
+def test_haos_managed_agent_update_mutations_are_refused(monkeypatch, operation):
+    """The editable HAOS Agent source boundary is fail-closed by default."""
+    monkeypatch.setattr(updates, '_AGENT_DIR', updates._HAOS_MANAGED_AGENT_DIR)
+    monkeypatch.setattr('api.config.load_settings', lambda: {})
+    monkeypatch.setattr(
+        updates, '_run_git',
+        lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError('git mutation attempted')),
+    )
+
+    result = operation()
+
+    assert result['ok'] is False
+    assert result['protected'] is True
+    assert 'allow_agent_updates=true' in result['message']
+
+
+def test_haos_managed_agent_update_check_does_not_fetch(monkeypatch):
+    """The update check must not fetch tags from the protected checkout."""
+    monkeypatch.setattr(updates, '_AGENT_DIR', updates._HAOS_MANAGED_AGENT_DIR)
+    monkeypatch.setattr('api.config.load_settings', lambda: {})
+    monkeypatch.setattr(
+        updates, '_run_git',
+        lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError('git fetch attempted')),
+    )
+
+    result = updates._check_repo(updates._AGENT_DIR, 'agent')
+
+    assert result['protected'] is True
+    assert result['ignored'] is True
+
+
+def test_haos_managed_agent_explicit_opt_in_allows_policy(monkeypatch):
+    """An explicit boolean opt-in is the only bypass for the managed path."""
+    monkeypatch.setattr(updates, '_AGENT_DIR', updates._HAOS_MANAGED_AGENT_DIR)
+    monkeypatch.setattr('api.config.load_settings', lambda: {'allow_agent_updates': True})
+
+    assert updates._agent_update_policy('agent') is None
+
+
+def test_webui_update_path_remains_available(monkeypatch):
+    """The HAOS Agent guard does not block the normal WebUI target."""
+    calls = []
+    monkeypatch.setattr(
+        updates, '_apply_update_inner',
+        lambda target, channel: calls.append((target, channel)) or {'ok': True, 'target': target},
+    )
+
+    result = updates.apply_update('webui')
+
+    assert result == {'ok': True, 'target': 'webui'}
+    assert calls and calls[0][0] == 'webui'
