@@ -38,6 +38,9 @@ try:
 except ImportError:
     _AGENT_DIR = None
 
+_HAOS_MANAGED_AGENT_DIR = Path('/usr/local/lib/haos-agent')
+_AGENT_UPDATE_OPT_IN_SETTING = 'allow_agent_updates'
+
 _update_cache = {'webui': None, 'agent': None, 'checked_at': 0, 'include_agent': True, 'channel': 'stable'}
 _SUMMARY_CACHE_MAX = 16
 _summary_cache: OrderedDict = OrderedDict()
@@ -70,6 +73,43 @@ _RELEASE_TAG_RE = re.compile(r'^v[0-9][0-9A-Za-z.+-]*$')
 # broad "lock file" substring from the prior version to avoid false positives
 # on unrelated errors like "lock file lost during ref transaction".
 # Matched case-insensitively in _is_git_lock_error().
+
+
+def _is_haos_managed_agent_target(path) -> bool:
+    """Return whether *path* is the HAOS editable Agent source boundary."""
+    if path is None:
+        return False
+    try:
+        return Path(path).resolve(strict=False) == _HAOS_MANAGED_AGENT_DIR
+    except OSError:
+        return False
+
+
+def _agent_update_policy(target: str, path=None) -> dict | None:
+    """Refuse WebUI mutations of the HAOS Agent checkout by default."""
+    if target != 'agent':
+        return None
+    path = _AGENT_DIR if path is None else path
+    if not _is_haos_managed_agent_target(path):
+        return None
+    try:
+        from api.config import load_settings
+        settings = load_settings()
+    except Exception:
+        settings = None
+    if isinstance(settings, dict) and settings.get(_AGENT_UPDATE_OPT_IN_SETTING) is True:
+        return None
+    return {
+        'ok': False,
+        'target': target,
+        'protected': True,
+        'message': (
+            'Updates to the HAOS-managed Agent checkout are disabled by default. '
+            f'Set {_AGENT_UPDATE_OPT_IN_SETTING}=true explicitly to opt in.'
+        ),
+    }
+
+
 _GIT_LOCK_SIGNATURES = (
     "index.lock': file exists",
     ".lock': file exists",
