# Copy to /etc/haos/haos-edge.env and adjust for the staging host.
# Secrets do not belong in this file.
HERMES_WEBUI_EDGE_HOST=127.0.0.1
HERMES_WEBUI_EDGE_PORT=8787
HERMES_WEBUI_PYTHON_PORT=8786
HERMES_WEBUI_STATIC_DIR=/opt/haos/hermes/platform/webui/static
# Leave empty for same-origin-only operation. Set one exact browser origin if needed.
HERMES_WEBUI_EDGE_CORS_ORIGIN=
